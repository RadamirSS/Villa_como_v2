{
  "name": "villa-como-v2",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check:data": "node scripts/verify-data.mjs",
    "check:plans": "node scripts/verify-plans.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:data && npm run check:plans && npm run check:interiors && npm run check:spatial && npm run check:geometry && npm run check:exterior && npm test && npm run typecheck",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:interiors": "node scripts/verify-interiors.mjs",
    "check:spatial": "node scripts/verify-spatial.mjs",
    "check:geometry": "node scripts/verify-architectural-geometry.mjs",
    "check:exterior": "node scripts/verify-exterior.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "@types/three": "0.170.0"
  }
}
