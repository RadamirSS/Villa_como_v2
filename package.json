{
  "name": "villa-como-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check:data": "node scripts/verify-data.mjs",
    "check:plans": "node scripts/verify-plans.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:data && npm run check:plans && npm test && npm run typecheck",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": { "react": "18.3.1", "react-dom": "18.3.1" },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
